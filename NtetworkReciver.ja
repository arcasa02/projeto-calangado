package com.projeto.calangado;

import android.app.Service;
import android.content.Intent;
import android.os.IBinder;
import android.speech.RecognizerIntent;
import android.speech.SpeechRecognizer;
import android.speech.RecognitionListener;
import android.os.Bundle;
import android.util.Log;
import java.util.ArrayList;

public class VoiceInputService extends Service {
	private static final String TAG = "VoiceInputService";
	private SpeechRecognizer speechRecognizer;
	private Intent recognizerIntent;

	@Override
	public void onCreate() {
    	super.onCreate();
    	Log.d(TAG, "Serviço Iniciado e Configurando Escuta...");
       
    	// Inicializa o Reconhecedor de Voz nativo do Android
    	speechRecognizer = SpeechRecognizer.createSpeechRecognizer(this);
       
    	// Configura as diretrizes de áudio para capturar o comando
    	recognizerIntent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
    	recognizerIntent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
    	recognizerIntent.putExtra(RecognizerIntent.EXTRA_CALLING_PACKAGE, this.getPackageName());
       
    	// Ativa o ouvinte que captura os resultados da voz
    	speechRecognizer.setRecognitionListener(new CustomRecognitionListener());
	}

	@Override
	public int onStartCommand(Intent intent, int flags, int startId) {
    	// Comando para iniciar a escuta contínua de áudio
    	speechRecognizer.startListening(recognizerIntent);
    	return START_STICKY; // Garante que o Android reinicie o serviço se faltar memória
	}

	@Override
	public void onDestroy() {
    	super.onDestroy();
    	if (speechRecognizer != null) {
        	speechRecognizer.destroy();
    	}
	}

	@Override
	public IBinder onBind(Intent intent) {
    	return null; // Não vinculativo, roda de forma independente
	}

	// Classe interna para processar os resultados capturados do microfone
	private class CustomRecognitionListener implements RecognitionListener {
    	@Override
    	public void onReadyForSpeech(Bundle params) {}
    	@Override
    	public void onBeginningOfSpeech() {}
    	@Override
    	public void onRmsChanged(float rmsdB) {}
    	@Override
    	public void onBufferReceived(byte[] buffer) {}
    	@Override
    	public void onEndOfSpeech() {}
    	@Override
    	public void onError(int error) {
        	// Em caso de erro ou silêncio, reinicia a escuta automaticamente
        	speechRecognizer.startListening(recognizerIntent);
    	}
    	@Override
    	public void onResults(Bundle results) {
        	// Captura o texto que o usuário falou
        	ArrayList<String> matches = results.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
        	if (matches != null && !matches.isEmpty()) {
            	String command = matches.get(0);
            	Log.d(TAG, "Comando de voz capturado: " + command);
               
            	// Aqui entra a sua lógica de IA do Calangado para processar o comando
        	}
        	// Mantém a escuta ativa para o próximo comando
        	speechRecognizer.startListening(recognizerIntent);
    	}
    	@Override
    	public void onPartialResults(Bundle partialResults) {}
    	@Override
    	public void onEvent(int eventType, Bundle params) {}
	}
}