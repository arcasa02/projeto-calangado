package com.projeto.calangado;

import android.content.ContentValues;
import android.content.Context;
import android.database.Cursor;
import android.database.sqlite.SQLiteDatabase;
import android.database.sqlite.SQLiteOpenHelper;
import android.util.Log;
import java.util.ArrayList;
import java.util.List;

public class VoiceCacheManager extends SQLiteOpenHelper {
    private static final String TAG = "VoiceCacheManager";
    private static final String DATABASE_NAME = "calangado_cache.db";
    private static final int DATABASE_VERSION = 1;
    
    private static final String TABLE_CACHE = "voice_commands";
    private static final String KEY_ID = "id";
    private static final String KEY_TEXT = "command_text";
    private static final String KEY_TIMESTAMP = "timestamp";

    public VoiceCacheManager(Context context) {
        super(context, DATABASE_NAME, null, DATABASE_VERSION);
    }

    @Override
    public void onCreate(SQLiteDatabase db) {
        String CREATE_TABLE = "CREATE TABLE " + TABLE_CACHE + "("
                + KEY_ID + " INTEGER PRIMARY KEY AUTOINCREMENT,"
                + KEY_TEXT + " TEXT,"
                + KEY_TIMESTAMP + " INTEGER" + ")";
        db.execSQL(CREATE_TABLE);
        Log.d(TAG, "Banco de dados de cache local criado com sucesso.");
    }

    @Override
    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
        db.execSQL("DROP TABLE IF EXISTS " + TABLE_CACHE);
        onCreate(db);
    }

    /**
     * Guarda um comando de voz no cache interno quando faltar internet
     */
    public synchronized void cacheOfflineCommand(String commandText) {
        SQLiteDatabase db = this.getWritableDatabase();
        ContentValues values = new ContentValues();
        values.put(KEY_TEXT, commandText);
        values.put(KEY_TIMESTAMP, System.currentTimeMillis());

        long id = db.insert(TABLE_CACHE, null, values);
        db.close();
        
        Log.d(TAG, "Comando armazenado em cache offline seguro. ID: " + id);
    }

    /**
     * Recupera todos os comandos acumulados no cache offline
     */
    public synchronized List<String> getPendingCommands() {
        List<String> commands = new ArrayList<>();
        String selectQuery = "SELECT * FROM " + TABLE_CACHE + " ORDER BY " + KEY_TIMESTAMP + " ASC";
        SQLiteDatabase db = this.getReadableDatabase();
        Cursor cursor = db.rawQuery(selectQuery, null);

        if (cursor.moveToFirst()) {
            do {
                commands.add(cursor.getString(cursor.getColumnIndexOrThrow(KEY_TEXT)));
            } while (cursor.moveToNext());
        }
        cursor.close();
        db.close();
        return commands;
    }

    /**
     * Limpa o cache após os comandos serem transmitidos com sucesso para a IA
     */
    public synchronized void clearSynchronizedCache() {
        SQLiteDatabase db = this.getWritableDatabase();
        db.delete(TABLE_CACHE, null, null);
        db.close();
        Log.d(TAG, "Cache offline limpo e sincronizado com o ecossistema.");
    }
}
